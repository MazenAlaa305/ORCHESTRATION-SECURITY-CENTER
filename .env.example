# Orchestration Security Center environment template
# Copy this file to .env and replace placeholder values before running.

# Required security secrets
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-64-character-random-hex

# Generate: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CREDENTIAL_ENCRYPTION_KEY=replace-with-fernet-key

# Main services
DATABASE_URL=postgresql://user:password@db:5432/sme_cyber_db
REDIS_URL=redis://redis:6379/0
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://localhost"]

# Optional AI advisor
LLM_PROVIDER=none
GEMINI_API_KEY=
LLM_DAILY_TOKEN_BUDGET=500000
LLM_PER_SCAN_TOKEN_BUDGET=50000
LLM_VALIDATION_ENABLED=false

# Optional scanner integrations
NMAP_ENABLED=true
NUCLEI_ENABLED=true
OPENVAS_ENABLED=false
OPENVAS_HOST=openvas
OPENVAS_PORT=9390
OPENVAS_USER=admin
OPENVAS_PASSWORD=admin

# Optional SIEM/SOAR integrations
SIEM_ENABLED=false
ELASTICSEARCH_URL=http://elasticsearch:9200
WAZUH_API_URL=https://wazuh:55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=wazuh
SOAR_ENABLED=false
N8N_WEBHOOK_URL=http://n8n:5678/webhook/

# Lab environment
LAB_ENABLED=true
LAB_COMPOSE_FILE=docker-compose.lab.yml
LAB_NETWORK_NAME=the-dashboard-project-_lab_network
LAB_DNS_SUFFIX=sme-lab.local
LAB_TRAFFIC_INTENSITY=medium
LAB_ELASTICSEARCH_INDEX=sme-lab-events-*
LAB_WAZUH_ALERT_INDEX=wazuh-alerts-*

# Reporting
REPORT_SIGNING_KEY=replace-with-report-signing-key
APP_VERSION=0.2.0-hardening