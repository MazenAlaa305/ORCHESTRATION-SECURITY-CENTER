# Found 404 — Backend Environment Variables
# Copy this file to .env and fill in your values.
# Never commit the actual .env file to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dashboard

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Feature flags (Phase 1 hardening — all OFF by default) ───────────────────
# Set to true ONLY when the backing service is reachable and tested.
# Leaving false shows an honest "not configured" state in the UI instead
# of fake / empty data.
SIEM_ENABLED=false
SOAR_ENABLED=false
OPENVAS_ENABLED=false
LLM_VALIDATION_ENABLED=false

# ── SIEM / Wazuh (only used when SIEM_ENABLED=true) ──────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=wazuh

# ── SOAR (only used when SOAR_ENABLED=true) ───────────────────────────────────
N8N_WEBHOOK_URL=http://localhost:5678/webhook/

# ── Security tools ────────────────────────────────────────────────────────────
NMAP_PATH=nmap
# Override if nuclei binary is not on PATH inside the Docker container
NUCLEI_PATH=nuclei

# ── OpenVAS (only used when OPENVAS_ENABLED=true) ────────────────────────────
OPENVAS_HOST=localhost
OPENVAS_PORT=9390
OPENVAS_USER=admin
OPENVAS_PASSWORD=admin

# ── CORS ─────────────────────────────────────────────────────────────────────
# BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Phase 3.1: JWT authentication ────────────────────────────────────────────
# REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME

# Token TTL in hours (default 8)
JWT_EXPIRE_HOURS=8

# ── Phase 3.2: Credential encryption at rest ─────────────────────────────────
# REQUIRED — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME

# ── Phase 3.3: LLM safety controls ───────────────────────────────────────────
# Set LLM_PROVIDER=none to disable all LLM calls (air-gapped deployments)
LLM_PROVIDER=gemini
LLM_DAILY_TOKEN_BUDGET=500000
LLM_PER_SCAN_TOKEN_BUDGET=50000
